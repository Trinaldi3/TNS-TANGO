<?xml version="1.0" encoding="utf-8"?>
<!-- Form Input Panen: kartu data, kartu hasil hitung otomatis, kartu tanda tangan, tombol simpan -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPanen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sipeka_surface"
    android:orientation="vertical">

    <!-- Toolbar + tombol back -->
    <include layout="@layout/include_toolbar" />

    <ScrollView
        android:id="@+id/scrollPanen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ============ Kartu 1: data panen ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/sipeka_white"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/panen_section_data"
                        android:textColor="@color/sipeka_green_500"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNama"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/panen_hint_nama"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNama"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBerat"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/panen_hint_berat"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBerat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/panen_label_lahan"
                        android:textColor="@color/sipeka_green_700"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <!-- Pilih satu: Datar atau Sulit -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupLahan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDatar"
                            style="@style/Widget.SIPEKA.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/panen_lahan_datar" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSulit"
                            style="@style/Widget.SIPEKA.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/panen_lahan_sulit" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilJanjang"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/panen_hint_janjang"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etJanjang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Kartu 2: hasil hitung otomatis (hijau tua, angka lime) ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/sipeka_green_700"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/panen_section_hasil"
                        android:textColor="@color/sipeka_green_200"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/panen_label_kotor"
                            android:textColor="@color/sipeka_white"
                            android:textSize="14sp"
                            app:fontFamily="@font/inter_medium" />

                        <TextView
                            android:id="@+id/tvUpahKotor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="@color/sipeka_white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:fontFamily="@font/plus_jakarta_sans_bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/panen_label_denda"
                            android:textColor="@color/sipeka_white"
                            android:textSize="14sp"
                            app:fontFamily="@font/inter_medium" />

                        <TextView
                            android:id="@+id/tvDenda"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="@color/sipeka_red_200"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:fontFamily="@font/plus_jakarta_sans_bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/sipeka_green_500" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/panen_label_bersih"
                        android:textColor="@color/sipeka_green_200"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <!-- Angka penting: Lime (brand highlight) di atas latar gelap -->
                    <TextView
                        android:id="@+id/tvUpahBersih"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:textColor="@color/sipeka_lime"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_extrabold" />

                    <TextView
                        android:id="@+id/tvInfoTarif"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/sipeka_green_200"
                        android:textSize="12sp"
                        app:fontFamily="@font/inter_medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Kartu 3: tanda tangan ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/sipeka_white"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/panen_section_ttd"
                        android:textColor="@color/sipeka_green_500"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_signature_pad">

                        <TextView
                            android:id="@+id/tvTtdHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/inter"
                            android:text="@string/panen_ttd_hint"
                            android:textColor="@color/sipeka_neutral_400"
                            android:textSize="14sp"
                            app:fontFamily="@font/inter" />

                        <com.example.tns_tango.core.ui.SignatureView
                            android:id="@+id/signaturePad"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvTtdError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/panen_err_ttd"
                        android:textColor="@color/sipeka_red_500"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:fontFamily="@font/inter_medium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHapusTtd"
                        style="@style/Widget.SIPEKA.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/panen_btn_hapus"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Big Button: simpan (hijau tua = aksi utama) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpan"
                style="@style/Widget.SIPEKA.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/panen_btn_simpan"
                android:textStyle="bold"
                app:fontFamily="@font/plus_jakarta_sans_bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
