<?xml version="1.0" encoding="utf-8"?>
<!-- Tab Website: header hijau + indikator loading + WebView (atau layar error) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sipeka_surface"
    android:orientation="vertical">

    <include
        android:id="@+id/pageHeader"
        layout="@layout/include_page_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Indikator loading halaman -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        android:max="100"
        android:visibility="gone"
        app:indicatorColor="@color/sipeka_lime"
        app:trackColor="@color/sipeka_green_700"
        app:trackThickness="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Komponen WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Tampilan saat gagal memuat (misalnya tidak ada sinyal) -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/sipeka_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/web_error_title"
                android:textColor="@color/sipeka_red_500"
                android:textSize="22sp"
                android:textStyle="bold"
                app:fontFamily="@font/plus_jakarta_sans_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="@string/web_error_desc"
                android:textColor="@color/sipeka_text_secondary"
                android:textSize="14sp"
                app:fontFamily="@font/inter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.SIPEKA.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/web_retry"
                android:textStyle="bold"
                app:fontFamily="@font/plus_jakarta_sans_bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
