<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAbout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sipeka_surface"
    android:orientation="vertical">

    <include layout="@layout/include_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/cd_logo"
                android:src="@drawable/ic_sipeka_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/app_title"
                android:textAppearance="@style/TextAppearance.SIPEKA.Heading"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                app:fontFamily="@font/plus_jakarta_sans_bold"
                android:textStyle="bold"
                android:textColor="@color/sipeka_green_700" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:text="@string/about_version"
                android:textAppearance="@style/TextAppearance.SIPEKA.Body"
                android:fontFamily="@font/inter"
                app:fontFamily="@font/inter"
                android:textColor="@color/sipeka_text_secondary" />

            <!-- Deskripsi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/sipeka_white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:padding="20dp"
                    android:text="@string/about_desc"
                    android:textAppearance="@style/TextAppearance.SIPEKA.Body"
                    android:fontFamily="@font/inter"
                    app:fontFamily="@font/inter"
                    android:textColor="@color/sipeka_text_primary" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Fokus fitur -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/sipeka_green_50"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sipeka_green_500"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold"
                        android:textStyle="bold"
                        android:text="@string/about_features_title"
                        android:textColor="@color/sipeka_green_700"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="6dp"
                        android:text="@string/about_features"
                        android:textAppearance="@style/TextAppearance.SIPEKA.Body"
                        android:fontFamily="@font/inter"
                        app:fontFamily="@font/inter"
                        android:textColor="@color/sipeka_text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pengembang -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/sipeka_yellow_100"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold"
                        android:textStyle="bold"
                        android:text="@string/about_dev_title"
                        android:textColor="@color/sipeka_yellow_700"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/about_dev"
                        android:textAppearance="@style/TextAppearance.SIPEKA.Body"
                        android:fontFamily="@font/inter"
                        app:fontFamily="@font/inter"
                        android:textColor="@color/sipeka_text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
