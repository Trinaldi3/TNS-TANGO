<?xml version="1.0" encoding="utf-8"?>
<!-- Tab Beranda: header hijau (logo + sapaan) lalu kartu ringkasan panen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sipeka_surface"
    android:orientation="vertical">

    <!-- Header hijau: logo, sapaan memakai username dari SharedPreferences -->
    <LinearLayout
        android:id="@+id/headerDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_page_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/ic_sipeka_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:textColor="@color/sipeka_white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:fontFamily="@font/plus_jakarta_sans_extrabold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_medium"
                android:text="@string/dash_subtitle"
                android:textColor="@color/sipeka_lime"
                android:textSize="13sp"
                app:fontFamily="@font/inter_medium" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tombol besar: buka form Input Panen (Lime = sorotan) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInputPanen"
                style="@style/Widget.SIPEKA.Button.Lime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/dash_btn_input_panen"
                android:textStyle="bold"
                app:fontFamily="@font/plus_jakarta_sans_bold"
                app:icon="@drawable/ic_add" />

            <!-- Kartu 1: total panen (hijau tua) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                app:cardBackgroundColor="@color/sipeka_green_700"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold"
                        android:textStyle="bold"
                        android:text="@string/dash_label_panen"
                        android:textColor="@color/sipeka_green_200"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        app:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:textStyle="bold"
                        android:text="@string/dash_value_panen"
                        android:textColor="@color/sipeka_white"
                        android:textSize="30sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Kartu 2: pemanen aktif (putih) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/sipeka_white"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold"
                        android:textStyle="bold"
                        android:text="@string/dash_label_pemanen"
                        android:textColor="@color/sipeka_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        app:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:textStyle="bold"
                        android:text="@string/dash_value_pemanen"
                        android:textColor="@color/sipeka_green_700"
                        android:textSize="30sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Kartu 3: total premi (lime, teks gelap) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/sipeka_lime"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold"
                        android:textStyle="bold"
                        android:text="@string/dash_label_premi"
                        android:textColor="@color/sipeka_green_700"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        app:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:textStyle="bold"
                        android:text="@string/dash_value_premi"
                        android:textColor="@color/sipeka_green_700"
                        android:textSize="30sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Info offline (warna Secondary / biru) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/sipeka_blue_100"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sipeka_blue_500"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold"
                        android:textStyle="bold"
                        android:text="@string/dash_offline_title"
                        android:textColor="@color/sipeka_blue_700"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/dash_offline_desc"
                        android:textAppearance="@style/TextAppearance.SIPEKA.Body"
                        android:fontFamily="@font/inter"
                        app:fontFamily="@font/inter"
                        android:textColor="@color/sipeka_blue_700" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
