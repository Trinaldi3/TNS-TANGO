<?xml version="1.0" encoding="utf-8"?>
<!-- Header hijau untuk tab Riwayat, Website, Tentang, Profil (tanpa tombol back karena ini halaman tab) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_page_header"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tvPageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans_extrabold"
        android:textColor="@color/sipeka_white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:fontFamily="@font/plus_jakarta_sans_extrabold" />
</LinearLayout>
