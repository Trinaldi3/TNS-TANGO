<?xml version="1.0" encoding="utf-8"?>
<!-- Tab Profil: header hijau + profil developer + tombol Keluar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sipeka_surface"
    android:orientation="vertical">

    <include
        android:id="@+id/pageHeader"
        layout="@layout/include_page_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Kartu identitas -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/sipeka_green_700"
                app:cardCornerRadius="28dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvAvatar"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:background="@drawable/bg_avatar"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:gravity="center"
                        android:text="@string/dev_initials"
                        android:textColor="@color/sipeka_green_700"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_extrabold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:gravity="center"
                        android:text="@string/dev_name"
                        android:textColor="@color/sipeka_white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_extrabold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/dev_role"
                        android:textColor="@color/sipeka_lime"
                        android:textSize="14sp"
                        app:fontFamily="@font/inter_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_sipeka_badge"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:paddingStart="14dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="5dp"
                        android:text="@string/dev_nim"
                        android:textColor="@color/sipeka_green_700"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter"
                        android:text="@string/dev_campus"
                        android:textColor="@color/sipeka_green_100"
                        android:textSize="13sp"
                        app:fontFamily="@font/inter" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tentang saya -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/sipeka_white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/dev_about_title"
                        android:textColor="@color/sipeka_green_700"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/dev_about"
                        android:textColor="@color/sipeka_text_primary"
                        android:textSize="14sp"
                        app:fontFamily="@font/inter" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hobi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/sipeka_green_50"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sipeka_green_500"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/dev_hobby_title"
                        android:textColor="@color/sipeka_green_700"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/dev_hobby_1"
                            android:textColor="@color/sipeka_green_700"
                            app:chipBackgroundColor="@color/sipeka_green_100"
                            app:chipStrokeWidth="0dp" />

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/dev_hobby_2"
                            android:textColor="@color/sipeka_green_700"
                            app:chipBackgroundColor="@color/sipeka_green_100"
                            app:chipStrokeWidth="0dp" />

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/dev_hobby_3"
                            android:textColor="@color/sipeka_green_700"
                            app:chipBackgroundColor="@color/sipeka_green_100"
                            app:chipStrokeWidth="0dp" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Kekuatan terbesar (kuning = sorotan) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/sipeka_yellow_100"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sipeka_yellow_500"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/dev_strength_title"
                        android:textColor="@color/sipeka_yellow_700"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/dev_strength"
                        android:textColor="@color/sipeka_text_primary"
                        android:textSize="14sp"
                        app:fontFamily="@font/inter" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sosial media (ketuk untuk membuka) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/sipeka_white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/dev_social_title"
                        android:textColor="@color/sipeka_green_700"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans_bold" />

                    <LinearLayout
                        android:id="@+id/rowGithub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/dev_github_label"
                            android:textColor="@color/sipeka_text_secondary"
                            android:textSize="12sp"
                            app:fontFamily="@font/inter_medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:text="@string/dev_github_value"
                            android:textColor="@color/sipeka_blue_600"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:fontFamily="@font/plus_jakarta_sans_bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@color/sipeka_neutral_200" />

                    <LinearLayout
                        android:id="@+id/rowInstagram"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/dev_instagram_label"
                            android:textColor="@color/sipeka_text_secondary"
                            android:textSize="12sp"
                            app:fontFamily="@font/inter_medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:text="@string/dev_instagram_value"
                            android:textColor="@color/sipeka_blue_600"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:fontFamily="@font/plus_jakarta_sans_bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@color/sipeka_neutral_200" />

                    <LinearLayout
                        android:id="@+id/rowLinkedin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/dev_linkedin_label"
                            android:textColor="@color/sipeka_text_secondary"
                            android:textSize="12sp"
                            app:fontFamily="@font/inter_medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:text="@string/dev_linkedin_value"
                            android:textColor="@color/sipeka_blue_600"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:fontFamily="@font/plus_jakarta_sans_bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@color/sipeka_neutral_200" />

                    <LinearLayout
                        android:id="@+id/rowEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/dev_email_label"
                            android:textColor="@color/sipeka_text_secondary"
                            android:textSize="12sp"
                            app:fontFamily="@font/inter_medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:text="@string/dev_email"
                            android:textColor="@color/sipeka_blue_600"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:fontFamily="@font/plus_jakarta_sans_bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tombol Keluar (merah = bahaya): hapus isLogin lalu kembali ke Login -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.SIPEKA.Button.Outlined.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/btn_logout"
                android:textStyle="bold"
                app:fontFamily="@font/plus_jakarta_sans_bold"
                app:icon="@drawable/ic_logout" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
