<?xml version="1.0" encoding="utf-8"?>
<!-- Halaman utama: tanpa Toolbar. Atas = tempat Fragment, bawah = Bottom Navigation -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sipeka_surface"
    android:orientation="vertical">

    <!-- Tempat Fragment ditampilkan (diisi oleh MainActivity.showTab) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Garis tipis pemisah, warna Neutral 200 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sipeka_neutral_200" />

    <!-- 5 menu: Beranda, Riwayat, Website, Tentang, Profil -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.SIPEKA.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_bottom_nav" />
</LinearLayout>
