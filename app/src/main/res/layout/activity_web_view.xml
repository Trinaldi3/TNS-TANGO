<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWebView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sipeka_surface"
    android:orientation="vertical">

    <!-- Toolbar + tombol back (menutup WebView, kembali ke Activity sebelumnya) -->
    <include layout="@layout/include_toolbar" />

    <!-- Indikator loading halaman -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        android:max="100"
        android:visibility="gone"
        app:indicatorColor="@color/sipeka_lime"
        app:trackColor="@color/sipeka_green_700"
        app:trackThickness="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. Komponen WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Tampilan saat gagal memuat (misalnya tidak ada sinyal) -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/sipeka_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/web_error_title"
                android:textAppearance="@style/TextAppearance.SIPEKA.Heading"
                android:textColor="@color/sipeka_red_500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/web_error_desc"
                android:textAppearance="@style/TextAppearance.SIPEKA.Body"
                android:textColor="@color/sipeka_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.SIPEKA.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/web_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
