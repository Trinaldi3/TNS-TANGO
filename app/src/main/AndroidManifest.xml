<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Izin akses internet (dibutuhkan WebViewActivity) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_title"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SIPEKA">

        <!-- Halaman pertama yang dibuka: SplashActivity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SIPEKA.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login (tujuan Splash jika isLogin = false). Toolbar + tombol back menutup halaman -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- Halaman awal setelah login (tanpa Toolbar). Tujuan Splash jika isLogin = true -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Halaman lain: Toolbar + tombol back ke MainActivity -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".WebViewActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ProfileDeveloperActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
    </application>
</manifest>
