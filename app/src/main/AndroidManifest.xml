<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Izin akses internet (dibutuhkan WebsiteFragment) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_title"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SIPEKA">

        <!-- Halaman pertama yang dibuka: SplashActivity -->
        <activity
            android:name=".feature.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SIPEKA.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login (tujuan Splash jika isLogin = false). Toolbar + tombol back menutup halaman -->
        <activity
            android:name=".feature.auth.LoginActivity"
            android:exported="false" />

        <!-- Halaman utama (tanpa Toolbar): tempat Bottom Navigation + 5 Fragment.
             Tujuan Splash jika isLogin = true dan tujuan setelah login berhasil -->
        <activity
            android:name=".feature.main.MainActivity"
            android:exported="false" />
    </application>
</manifest>
